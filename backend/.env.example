# Servidor
PORT=5000
NODE_ENV=development

# Base de datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=quizqueya
DB_USER=postgres
DB_PASSWORD=postgres

# Seguridad
JWT_SECRET=cambia-esta-clave-en-produccion
JWT_EXPIRES_IN=30d

# CORS (dominios permitidos separados por coma o * para todos)
CORS_ORIGIN=*

# Fronteend
FRONTEND_URL=http://localhost:5173
